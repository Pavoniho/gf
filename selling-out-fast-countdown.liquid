<div class="smo-sof" style="width:100%;margin:0;padding:0;">
  <p class="smo-sof-txt" style="margin:0;padding:0;font-size:16px;line-height:1.5625;color:#000;font-weight:400;"><strong style="font-weight:500;">Selling out fast</strong><br>Due to high demand, quantities are limited.</p>
  <div style="width:100%;padding-top:6px;padding-bottom:20px;">
    <div style="width:100%;height:10px;background-color:#f7f7f7;border-radius:4px;overflow:hidden;margin:0 0 7px 0;padding:0;">
      <div style="height:100%;width:89%;background-color:#df8096;margin:0;padding:0;"></div>
    </div>
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin:0;padding:0;">
      <span style="color:#000;font-size:16px;font-weight:500;line-height:1.5625;">89% sold</span>
      <span style="color:#df8096;font-size:16px;font-weight:500;line-height:1.5625;">Ends in&nbsp;<span class="smo-sof-time" style="font-variant-numeric:tabular-nums;">00:00:00</span></span>
    </div>
  </div>
</div>
<script>
(function () {
  if (window.smoSofTimer) return;
  window.smoSofTimer = true;
  function p(n) { return (n < 10 ? '0' : '') + n; }
  function tick() {
    var now = new Date();
    var end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0, 0);
    var d = end.getTime() - now.getTime();
    if (d < 0) d = 0;
    var t = p(Math.floor(d / 3600000)) + ':' + p(Math.floor((d % 3600000) / 60000)) + ':' + p(Math.floor((d % 60000) / 1000));
    var els = document.getElementsByClassName('smo-sof-time');
    for (var i = 0; i < els.length; i++) els[i].textContent = t;
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
